# Resend (formulario de contacto de /acerca-de)

# Obligatoria. Clave de la API de Resend (https://resend.com/api-keys).
RESEND_API_KEY=

# Obligatoria. Destino de los mensajes del formulario.
# Con el remitente de prueba (onboarding@resend.dev) debe ser el correo
# de la cuenta de Resend; otros destinos son rechazados.
CONTACT_TO_EMAIL=

# Opcional. Remitente. Por defecto: Arcade Vault <onboarding@resend.dev>
# Con dominio propio verificado en Resend: Arcade Vault <contacto@tudominio.com>
CONTACT_FROM_EMAIL=
